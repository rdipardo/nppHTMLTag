#include "dialogs.h"

IT_ABOUT_DLG DIALOGEX 30, 30, 232, 170
STYLE DS_SETFONT | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_DLGMODALFRAME
CAPTION IT_ABOUT_CAPTION
FONT 8, "Tahoma", 0, 0, 0
BEGIN
    LTEXT      "", ID_PLUGIN_VERSION_TXT, 75,6,126,16
