    LTEXT      PLUGIN_MAINTAINER_COPYRIGHT, ID_PLUGIN_MAINTAINER_TXT, 56,64,256,10
    LTEXT      "", ID_PLUGIN_LICENSE_TXT, 78,76,256,10
    LTEXT      "", ID_SIMPLEINI_TXT, 27,88,64,10
    CONTROL    "SimpleIni", ID_SIMPLEINI_LINK, "Static", DEFAULT_LINK_STYLE, 63,88,30,10
    LTEXT      SIMPLEINI_COPYRIGHT, ID_SIMPLEINI_LICENSE_TXT, 93,88,256,14
