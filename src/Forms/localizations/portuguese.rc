    LTEXT      PLUGIN_AUTHOR_COPYRIGHT, ID_PLUGIN_AUTHOR_TXT, 44,54,256,10
    LTEXT      PLUGIN_MAINTAINER_COPYRIGHT, ID_PLUGIN_MAINTAINER_TXT, 56,64,256,10
    LTEXT      PT_ABOUT_LICENSE, ID_PLUGIN_LICENSE_TXT, 78,76,256,10
