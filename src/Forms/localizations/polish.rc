#include "dialogs.h"

PL_ABOUT_DLG DIALOGEX 30, 30, 232, 170
STYLE DS_SETFONT | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_DLGMODALFRAME
CAPTION PL_ABOUT_CAPTION
FONT 8, "Tahoma", 0, 0, 0
BEGIN
    LTEXT      "", ID_PLUGIN_VERSION_TXT, 75,6,128,16
    CONTROL    "", ID_RELEASE_NOTES_LINK, "Static", DEFAULT_LINK_STYLE, 76,18,76,10
    CONTROL    "", ID_BUG_TRACKER_LINK, "Static", DEFAULT_LINK_STYLE, 98,28,20,10
    CONTROL    "", ID_PLUGIN_REPO_LINK, "Static", DEFAULT_LINK_STYLE, 81,38,54,16
    LTEXT      PLUGIN_AUTHOR_COPYRIGHT, ID_PLUGIN_AUTHOR_TXT, 44,54,256,10
    LTEXT      PLUGIN_MAINTAINER_COPYRIGHT, ID_PLUGIN_MAINTAINER_TXT, 56,64,256,10
    LTEXT      "", ID_PLUGIN_LICENSE_TXT, 80,76,256,10
    LTEXT      "", ID_SIMPLEINI_TXT, 30,88,64,10
    CONTROL    "SimpleIni", ID_SIMPLEINI_LINK, "Static", DEFAULT_LINK_STYLE, 64,88,30,10
    LTEXT      SIMPLEINI_COPYRIGHT, ID_SIMPLEINI_LICENSE_TXT, 95,88,256,14
    LTEXT      "", ID_TINYXML_TXT, 17,98,256,14
    CONTROL    "TinyXML-2", ID_TINYXML_LINK, "Static", DEFAULT_LINK_STYLE, 77,98,34,14
    LTEXT      TINYXML_COPYRIGHT, ID_TINYXML_LICENSE_TXT, 111,98,256,14
    CONTROL    "", ID_ENTITIES_FILE_LINK, "Static", DEFAULT_LINK_STYLE, 83,112,56,10
    CONTROL    "", ID_TRANSLATIONS_FILE_LINK, "Static", DEFAULT_LINK_STYLE, 85,124,48,10
    LTEXT      "", ID_UNICODE_FMT_LABEL_TXT, 56,138,136,10
    LTEXT      "\\u0000", ID_UNICODE_USER_FMT_TXT, 139,138,64,10
    CONTROL    "", ID_UNICODE_CONFIG_LINK, "Static", DEFAULT_LINK_STYLE, 90,148,38,10
END

PL_UNICODE_DLG DIALOGEX 30, 60, 200, 52
STYLE DS_SETFONT | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_DLGMODALFRAME | WS_EX_TOPMOST
CAPTION PL_UNICODE_DLG_CAPTION
FONT 8, "Tahoma", 0, 0, 0
BEGIN
    LTEXT           "", ID_CONFIG_LABEL_1, 54,12,32,12
    EDITTEXT        ID_CONFIG_EDIT, 84,10,32,12, ES_RIGHT | ES_MULTILINE | ES_WANTRETURN
    LTEXT           "0000", ID_CONFIG_LABEL_2, 120,12,32,12
    DEFPUSHBUTTON   "", IDCANCEL, 136,32,48,14, DEFAULT_BTTN_STYLE
    DEFPUSHBUTTON   "", IDRETRY, 68,32,64,14, DEFAULT_BTTN_STYLE
    DEFPUSHBUTTON   "", IDOK, 16,32,48,14, DEFAULT_BTTN_STYLE
END
