FONT 9, "Segoe UI", 0, 0, 0
BEGIN
    LTEXT          TA_UNICODE_DLG_FORMAT, ID_CONFIG_LABEL_1, 48,12,38,12
    EDITTEXT       ID_CONFIG_EDIT, 84,10,32,12, ES_RIGHT | ES_MULTILINE | ES_WANTRETURN
    LTEXT          "0000", ID_CONFIG_LABEL_2, 120,12,32,12
    DEFPUSHBUTTON  TA_UNICODE_DLG_CANCEL, IDCANCEL, 128,32,64,14, DEFAULT_BTTN_STYLE
    DEFPUSHBUTTON  TA_UNICODE_DLG_RESET, IDRETRY, 60,32,64,14, DEFAULT_BTTN_STYLE
    DEFPUSHBUTTON  TA_UNICODE_DLG_OK, IDOK, 8,32,48,14, DEFAULT_BTTN_STYLE
END
