    CONTROL   TA_ABOUT_DOWNLOADS, ID_PLUGIN_REPO_LINK, "Static", DEFAULT_LINK_STYLE, 84,38,68,16
    LTEXT     PLUGIN_AUTHOR_COPYRIGHT, ID_PLUGIN_AUTHOR_TXT, 44,54,256,10
    LTEXT     PLUGIN_MAINTAINER_COPYRIGHT, ID_PLUGIN_MAINTAINER_TXT, 56,64,256,10
    LTEXT     TA_ABOUT_LICENSE, ID_PLUGIN_LICENSE_TXT, 74,76,256,10
    LTEXT     TA_ABOUT_3RD_PARTY, ID_SIMPLEINI_TXT, 21,88,64,10
    CONTROL   "SimpleIni", ID_SIMPLEINI_LINK, "Static", DEFAULT_LINK_STYLE, 75,88,30,10
