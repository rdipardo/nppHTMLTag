    CONTROL    JP_ABOUT_DOWNLOADS, ID_PLUGIN_REPO_LINK, "Static", DEFAULT_LINK_STYLE, 94,36,36,16
    LTEXT      PLUGIN_AUTHOR_COPYRIGHT, ID_PLUGIN_AUTHOR_TXT, 41,54,256,10
    LTEXT      PLUGIN_MAINTAINER_COPYRIGHT, ID_PLUGIN_MAINTAINER_TXT, 53,64,256,10
    LTEXT      JP_ABOUT_LICENSE, ID_PLUGIN_LICENSE_TXT, 72,76,256,10
    LTEXT      JP_ABOUT_3RD_PARTY, ID_SIMPLEINI_TXT, 36,88,64,10
