#include "dialogs.h"

JP_ABOUT_DLG DIALOGEX 30, 30, 232, 170
STYLE DS_SETFONT | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_DLGMODALFRAME
CAPTION JP_ABOUT_CAPTION
FONT 9, "Segoe UI", 0, 0, 0
BEGIN
    LTEXT      JP_ABOUT_VERSION, ID_PLUGIN_VERSION_TXT, 74,6,128,16
