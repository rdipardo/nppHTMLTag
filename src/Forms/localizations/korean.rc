#include "dialogs.h"

KO_ABOUT_DLG DIALOGEX 30, 30, 232, 170
STYLE DS_SETFONT | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_DLGMODALFRAME
CAPTION KO_ABOUT_CAPTION
FONT 9, "Segoe UI", 0, 0, 0
BEGIN
    LTEXT      KO_ABOUT_VERSION, ID_PLUGIN_VERSION_TXT, 80,6,128,16
    CONTROL    KO_ABOUT_REL_NOTES, ID_RELEASE_NOTES_LINK, "Static", DEFAULT_LINK_STYLE, 93,18,36,10
    CONTROL    KO_ABOUT_BUGS, ID_BUG_TRACKER_LINK, "Static", DEFAULT_LINK_STYLE, 101,28,18,10
    CONTROL    KO_ABOUT_DOWNLOADS, ID_PLUGIN_REPO_LINK, "Static", DEFAULT_LINK_STYLE, 94,38,32,16
    LTEXT      PLUGIN_AUTHOR_COPYRIGHT, ID_PLUGIN_AUTHOR_TXT, 41,54,256,10
    LTEXT      PLUGIN_MAINTAINER_COPYRIGHT, ID_PLUGIN_MAINTAINER_TXT, 53,64,256,10
    LTEXT      KO_ABOUT_LICENSE, ID_PLUGIN_LICENSE_TXT, 72,76,256,10
    LTEXT      KO_ABOUT_3RD_PARTY, ID_SIMPLEINI_TXT, 36,88,64,10
    CONTROL    "SimpleIni", ID_SIMPLEINI_LINK, "Static", DEFAULT_LINK_STYLE, 53,88,30,10
    LTEXT      SIMPLEINI_COPYRIGHT, ID_SIMPLEINI_LICENSE_TXT, 83,88,256,14
    LTEXT      KO_ABOUT_3RD_PARTY_ALSO, ID_TINYXML_TXT, 30,98,256,14
    CONTROL    "TinyXML-2", ID_TINYXML_LINK, "Static", DEFAULT_LINK_STYLE, 63,98,34,14
    LTEXT      TINYXML_COPYRIGHT, ID_TINYXML_LICENSE_TXT, 97,98,256,14
    CONTROL    KO_ABOUT_ENTITIES_FILE, ID_ENTITIES_FILE_LINK, "Static", DEFAULT_LINK_STYLE, 91,112,44,10
    CONTROL    KO_ABOUT_L10N_FILE, ID_TRANSLATIONS_FILE_LINK, "Static", DEFAULT_LINK_STYLE, 94,124,36,10
    LTEXT      KO_ABOUT_UNICODE_FORMAT, ID_UNICODE_FMT_LABEL_TXT, 64,138,128,10
    LTEXT      "\\u0000", ID_UNICODE_USER_FMT_TXT, 130,138,64,10
    CONTROL    KO_ABOUT_UNICODE_CONFIG, ID_UNICODE_CONFIG_LINK, "Static", DEFAULT_LINK_STYLE, 101,148,18,10
END

KO_UNICODE_DLG DIALOGEX 30, 60, 160, 52
STYLE DS_SETFONT | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_DLGMODALFRAME | WS_EX_TOPMOST
CAPTION KO_UNICODE_DLG_CAPTION
FONT 9, "Segoe UI", 0, 0, 0
BEGIN
    LTEXT           KO_UNICODE_DLG_FORMAT, ID_CONFIG_LABEL_1, 38,12,32,12
    EDITTEXT        ID_CONFIG_EDIT, 60,10,32,12, ES_RIGHT | ES_MULTILINE | ES_WANTRETURN
    LTEXT           "0000", ID_CONFIG_LABEL_2, 96,12,32,12
    DEFPUSHBUTTON   KO_UNICODE_DLG_CANCEL, IDCANCEL, 100,32,32,14, DEFAULT_BTTN_STYLE
    DEFPUSHBUTTON   KO_UNICODE_DLG_RESET, IDRETRY, 64,32,32,14, DEFAULT_BTTN_STYLE
    DEFPUSHBUTTON   KO_UNICODE_DLG_OK, IDOK, 28,32,32,14, DEFAULT_BTTN_STYLE
END
