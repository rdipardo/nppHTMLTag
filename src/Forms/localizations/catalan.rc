    CONTROL    CA_ABOUT_ENTITIES_FILE, ID_ENTITIES_FILE_LINK, "Static", DEFAULT_LINK_STYLE, 79,112,72,10
    CONTROL    CA_ABOUT_L10N_FILE, ID_TRANSLATIONS_FILE_LINK, "Static", DEFAULT_LINK_STYLE, 79,124,68,10
    LTEXT      CA_ABOUT_UNICODE_FORMAT, ID_UNICODE_FMT_LABEL_TXT, 53,138,142,10
