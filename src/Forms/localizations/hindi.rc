HI_UNICODE_DLG DIALOGEX 30, 60, 200, 52
STYLE DS_SETFONT | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_DLGMODALFRAME | WS_EX_TOPMOST
CAPTION HI_UNICODE_DLG_CAPTION
FONT 9, "Segoe UI", 0, 0, 0
BEGIN
    LTEXT          HI_UNICODE_DLG_FORMAT, ID_CONFIG_LABEL_1, 57,12,32,12
    EDITTEXT       ID_CONFIG_EDIT, 84,10,32,12, ES_RIGHT | ES_MULTILINE | ES_WANTRETURN
    LTEXT          "0000", ID_CONFIG_LABEL_2, 120,12,32,12
    DEFPUSHBUTTON  HI_UNICODE_DLG_CANCEL, IDCANCEL, 136,32,48,14, DEFAULT_BTTN_STYLE
    DEFPUSHBUTTON  HI_UNICODE_DLG_RESET, IDRETRY, 68,32,64,14, DEFAULT_BTTN_STYLE
    DEFPUSHBUTTON  HI_UNICODE_DLG_OK, IDOK, 16,32,48,14, DEFAULT_BTTN_STYLE
END
