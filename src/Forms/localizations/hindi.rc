    CONTROL   HI_ABOUT_DOWNLOADS, ID_PLUGIN_REPO_LINK, "Static", DEFAULT_LINK_STYLE, 91,38,34,16
    LTEXT     PLUGIN_AUTHOR_COPYRIGHT, ID_PLUGIN_AUTHOR_TXT, 44,54,256,10
    LTEXT     PLUGIN_MAINTAINER_COPYRIGHT, ID_PLUGIN_MAINTAINER_TXT, 56,64,256,10
    LTEXT     HI_ABOUT_LICENSE, ID_PLUGIN_LICENSE_TXT, 74,76,256,10
    LTEXT     HI_ABOUT_3RD_PARTY, ID_SIMPLEINI_TXT, 24,88,64,10
    CONTROL   "SimpleIni", ID_SIMPLEINI_LINK, "Static", DEFAULT_LINK_STYLE, 72,88,30,10
    LTEXT     SIMPLEINI_COPYRIGHT, ID_SIMPLEINI_LICENSE_TXT, 102,88,256,14
    LTEXT     HI_ABOUT_3RD_PARTY_ALSO, ID_TINYXML_TXT, 19,98,256,14
    CONTROL   "TinyXML-2", ID_TINYXML_LINK, "Static", DEFAULT_LINK_STYLE, 76,98,34,14
    LTEXT     TINYXML_COPYRIGHT, ID_TINYXML_LICENSE_TXT, 110,98,256,14
    CONTROL   HI_ABOUT_ENTITIES_FILE, ID_ENTITIES_FILE_LINK, "Static", DEFAULT_LINK_STYLE, 81,112,62,10
    CONTROL   HI_ABOUT_L10N_FILE, ID_TRANSLATIONS_FILE_LINK, "Static", DEFAULT_LINK_STYLE, 88,124,46,10
    LTEXT     HI_ABOUT_UNICODE_FORMAT, ID_UNICODE_FMT_LABEL_TXT, 65,138,136,10
    LTEXT     "\\u0000", ID_UNICODE_USER_FMT_TXT, 125,138,64,10
    CONTROL   HI_ABOUT_UNICODE_CONFIG, ID_UNICODE_CONFIG_LINK, "Static", DEFAULT_LINK_STYLE, 89,148,42,10
