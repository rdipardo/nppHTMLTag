#include "dialogs.h"

HI_ABOUT_DLG DIALOGEX 30, 30, 232, 170
STYLE DS_SETFONT | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_DLGMODALFRAME
CAPTION HI_ABOUT_CAPTION
FONT 9, "Segoe UI", 0, 0, 0
BEGIN
    LTEXT     HI_ABOUT_VERSION, ID_PLUGIN_VERSION_TXT, 75,6,128,16
    CONTROL   HI_ABOUT_REL_NOTES, ID_RELEASE_NOTES_LINK, "Static", DEFAULT_LINK_STYLE, 92,18,32,10
