    CONTROL    "", ID_ENTITIES_FILE_LINK, "Static", DEFAULT_LINK_STYLE, 79,112,62,10
    CONTROL    "", ID_TRANSLATIONS_FILE_LINK, "Static", DEFAULT_LINK_STYLE, 81,124,58,10
